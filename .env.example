# Supabase (públicas: vão dentro do app)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Sentry: DSN é público; o resto é usado só no build para enviar source maps
EXPO_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
SENTRY_ORG=sua-org
SENTRY_PROJECT=app-mobile
# SENTRY_AUTH_TOKEN=  -> NUNCA commitar; use .env.local e `eas env:create` (visibility: secret)

# Assinaturas (públicas). Superwall: Settings → Keys. RevenueCat: Project → API keys (appl_... / goog_...)
# Sem elas (ou no Expo Go/web) o app roda com assinaturas desligadas.
EXPO_PUBLIC_SUPERWALL_IOS_KEY=pk_xxx
EXPO_PUBLIC_SUPERWALL_ANDROID_KEY=pk_xxx
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
